<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#aaaaaa"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center" />

        <Button
            android:layout_width="wrap_content"
            android:text="删除"
            android:id="@+id/btn_delete"
            android:layout_height="match_parent"/>
        <com.cy.androidview.selectorview.ImageViewSelector
            android:id="@+id/ivs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right|bottom"
            android:padding="10dp"
            app:cy_srcChecked="@drawable/cb_selected_rect_blue"
            app:cy_srcUnChecked="@drawable/cb_unselected_rect_white" />
    </LinearLayout>

    <com.cy.rvadapterniubility.recyclerview.VerticalGridRecyclerView
        android:id="@+id/grv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
